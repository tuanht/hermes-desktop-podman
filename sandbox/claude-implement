#!/usr/bin/env bash
# claude-implement: have Claude Code write a change on a local branch; push and open the PR ONLY after review approval.
# Three modes (Claude Code only edits files; this script commits, pushes and opens PRs, so the model has NO git-write/gh access):
#   new work   claude-implement <owner/repo|N> --branch task/slug --spec-file FILE [options]
#              creates the branch from the base, lets Claude edit, COMMITS LOCALLY. Does not push.
#   rework     claude-implement <owner/repo|N> (--branch task/slug --continue | --pr N) --spec-file FILE [options]
#              continues an existing branch (the local one, else origin's; --pr N takes the branch of that open PR),
#              applies the feedback as a new local commit. Does not push.
#   publish    claude-implement <owner/repo|N> (--branch task/slug | --pr N) --publish --expect-sha SHA
#              pushes the branch and opens the PR (or comments on the existing one). Refuses unless HEAD is exactly
#              the reviewed SHA, so unreviewed commits can never be published.
# Options:
#   --model ALIAS    Claude Code model (default sonnet; opus for hard tasks)
#   --base BRANCH    base branch (default: the repo's default branch)
#   --title TEXT     commit/PR title (default: first line of the spec)
#   --spec-file -    read the spec from stdin (use with a heredoc; saved under ~/work/.tasks/)
#   --background     detach: print LOG=<path> and return at once; poll the log for a final DONE line
#   --build          allow Claude to run `npm ci` and `npm run ...` (trusted repos only; default OFF)
# Output: log/report under ~/work/.tasks/. Last lines: BRANCH= / COMMITS= / HEAD_SHA= / SUMMARY= / DONE (edit modes),
#   BRANCH= / PUBLISHED_SHA= / PR_URL= (or COMPARE_URL=) / DONE (publish), or ERROR: / DONE.
# Typical call from an agent (one plain command, no nohup, no &, no redirects):
#   claude-implement tuanht/tuanht-blog --branch task/x --model sonnet --title "T" --spec-file - --background <<'SPEC'
#   ...ticket text, verbatim...
#   SPEC
set -uo pipefail

MODEL=sonnet BASE="" TITLE="" BUILD=0 BG=0 BRANCH="" SPEC="" REPO_ARG="" PR="" CONTINUE=0 PUBLISH=0 EXPECT=""
ARGS=("$@")
while (($#)); do
    case "$1" in
        --branch) BRANCH="$2"; shift 2 ;;
        --pr) PR="$2"; shift 2 ;;
        --continue) CONTINUE=1; shift ;;
        --publish) PUBLISH=1; shift ;;
        --expect-sha) EXPECT="$2"; shift 2 ;;
        --spec-file) SPEC="$2"; shift 2 ;;
        --model) MODEL="$2"; shift 2 ;;
        --base) BASE="$2"; shift 2 ;;
        --title) TITLE="$2"; shift 2 ;;
        --build) BUILD=1; shift ;;
        --background) BG=1; shift ;;
        -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
        *) REPO_ARG="$1"; shift ;;
    esac
done
SPEC="${SPEC/#\~/$HOME}"   # tolerate a literal ~ that the caller's shell did not expand
usage() { echo "usage: claude-implement <repo> (--branch B [--continue] | --pr N) --spec-file F [options]   |   ... --publish --expect-sha SHA" >&2; exit 2; }
[[ -n "$REPO_ARG" && ( -n "$BRANCH" || -n "$PR" ) ]] || usage
if ((PUBLISH)); then [[ -n "$EXPECT" && "$EXPECT" =~ ^[0-9a-f]{7,40}$ ]] || usage
else [[ "$SPEC" == - || -f "$SPEC" ]] || usage; fi
[[ -z "$PR" || "$PR" =~ ^[0-9]+$ ]] || { echo "bad PR number" >&2; exit 2; }
[[ -n "$PR" || "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "bad branch name" >&2; exit 2; }
[[ -z "$PR" ]] || CONTINUE=1
[[ "$REPO_ARG" =~ ^[0-9]*$ ]] && REPO="tuanht/tuanht-blog" || REPO="$REPO_ARG"

DIR="$HOME/work/${REPO#*/}" OUT="$HOME/work/.tasks"
mkdir -p "$OUT"
STAMP="$(date +%Y%m%d-%H%M%S)"
TAG="${BRANCH//\//_}"; [[ -z "$PR" ]] || TAG="pr$PR"
ID="${CLAUDE_IMPLEMENT_ID:-${REPO//\//_}-$TAG-$STAMP}"
LOG="$OUT/$ID.log" SUMMARY="$OUT/$ID.summary.md"
if ((!PUBLISH)) && [[ "$SPEC" == - ]]; then SPEC="$OUT/$ID.spec.md"; cat > "$SPEC"; [[ -s "$SPEC" ]] || { echo "empty spec on stdin" >&2; exit 2; }; fi
if ((BG)) && [[ -z "${CLAUDE_IMPLEMENT_ID:-}" ]]; then
    # Detach a child that runs the same command (spec already saved to a file) and return immediately.
    CHILD=(); skip=0
    for a in "${ARGS[@]}"; do
        if ((skip)); then skip=0; continue; fi
        case "$a" in --background) ;; --spec-file) CHILD+=("$a" "$SPEC"); skip=1 ;; *) CHILD+=("$a") ;; esac
    done
    CLAUDE_IMPLEMENT_ID="$ID" setsid nohup "$0" "${CHILD[@]}" >/dev/null 2>&1 < /dev/null &
    echo "STARTED=yes"; echo "LOG=$LOG"; echo "POLL: tail -n 5 $LOG   (finished when a line DONE appears)"
    exit 0
fi
exec > >(tee -a "$LOG") 2>&1
MODE=new; ((CONTINUE)) && MODE=rework; ((PUBLISH)) && MODE=publish
echo "== claude-implement $REPO mode=$MODE ${PR:+pr=$PR }branch=${BRANCH:-?} model=$MODEL build=$BUILD"
fail() { echo "ERROR: $*"; echo "DONE"; exit 1; }

((PUBLISH)) || command -v claude >/dev/null || fail "claude CLI not found"
if [[ ! -d "$DIR/.git" ]]; then
    git clone "git@github.com:$REPO.git" "$DIR" || fail "clone failed"
fi
cd "$DIR" || fail "no checkout"
[[ -z "$(git status --porcelain)" ]] || fail "checkout $DIR has uncommitted changes; clean it first"

if [[ -n "$PR" ]]; then
    # Take branch and base from the open PR itself; refuse closed PRs and forks.
    INFO="$(gh pr view "$PR" -R "$REPO" --json state,headRefName,baseRefName,isCrossRepository,title \
        --jq '[.state,.headRefName,.baseRefName,(.isCrossRepository|tostring),.title]|@tsv' 2>&1)" || fail "cannot read PR #$PR: $INFO"
    IFS=$'\t' read -r PSTATE PHEAD PBASE PFORK PTITLE <<<"$INFO"
    [[ "$PSTATE" == OPEN ]] || fail "PR #$PR is $PSTATE, not OPEN"
    [[ "$PFORK" == false ]] || fail "PR #$PR comes from a fork; refusing to push"
    [[ "$PHEAD" =~ ^[A-Za-z0-9._/-]+$ && "$PHEAD" != "$PBASE" ]] || fail "unexpected PR head branch '$PHEAD'"
    BRANCH="$PHEAD" BASE="$PBASE"
fi
[[ -n "$BASE" ]] || BASE="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
[[ -n "$BASE" ]] || BASE=master
git fetch -q origin "+refs/heads/$BASE:refs/remotes/origin/$BASE" || fail "fetch base failed"
META="$OUT/branch-${REPO//\//_}-${BRANCH//\//_}"   # .title, .body.md (accumulated PR body), .last.md (latest round)

if ((PUBLISH)); then
    git rev-parse -q --verify "refs/heads/$BRANCH" >/dev/null || fail "no local branch $BRANCH to publish"
    HEAD_SHA="$(git rev-parse "refs/heads/$BRANCH")"
    [[ "$HEAD_SHA" == "$EXPECT"* ]] || fail "branch head ${HEAD_SHA:0:12} is not the reviewed commit $EXPECT; get the new commits reviewed first"
    git checkout -q "$BRANCH" || fail "cannot check out $BRANCH"
    git push -q -u origin "$BRANCH" || fail "push failed (deploy key write access?)"
    echo "BRANCH=$BRANCH"; echo "PUBLISHED_SHA=$HEAD_SHA"
    [[ -n "$TITLE" ]] || TITLE="$(cat "$META.title" 2>/dev/null || echo "$BRANCH")"
    [[ -n "$PR" ]] || PR="$(gh pr list -R "$REPO" --head "$BRANCH" --state open --json number --jq '.[0].number // empty' 2>/dev/null)"
    if [[ -n "$PR" ]]; then
        if [[ -s "$META.last.md" ]] && gh pr comment "$PR" -R "$REPO" --body-file "$META.last.md" >/dev/null 2>&1; then echo "POSTED=comment on #$PR"
        else echo "WARN: no comment posted on #$PR"; fi
        echo "PR_URL=https://github.com/$REPO/pull/$PR"
    else
        BODY="$META.body.md"; [[ -s "$BODY" ]] || BODY="$META.last.md"
        [[ -s "$BODY" ]] || { echo "Branch $BRANCH" > "$META.body.md"; BODY="$META.body.md"; }
        URL="$(gh pr create -R "$REPO" --base "$BASE" --head "$BRANCH" --title "$TITLE" --body-file "$BODY" 2>&1 | tail -n 1)"
        if [[ "$URL" == https://* ]]; then echo "PR_URL=$URL"
        else echo "WARN: gh pr create failed: $URL"
             echo "COMPARE_URL=https://github.com/$REPO/compare/$BASE...$BRANCH?expand=1"; fi
    fi
    echo "DONE"; exit 0
fi

if ((CONTINUE)); then
    git fetch -q origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" 2>/dev/null
    if git rev-parse -q --verify "refs/heads/$BRANCH" >/dev/null; then git checkout -q "$BRANCH" || fail "cannot check out $BRANCH"
    elif git rev-parse -q --verify "refs/remotes/origin/$BRANCH" >/dev/null; then git checkout -q -b "$BRANCH" "origin/$BRANCH" || fail "cannot check out origin/$BRANCH"
    else fail "branch $BRANCH exists neither locally nor on origin; start it without --continue"; fi
else
    git rev-parse -q --verify "refs/heads/$BRANCH" >/dev/null && fail "branch $BRANCH already exists locally; use --continue for rework or pick a new name"
    git checkout -q -b "$BRANCH" "origin/$BASE" || fail "cannot create branch"
fi
START="$(git rev-parse HEAD)"
if [[ -z "$TITLE" ]]; then
    if ((CONTINUE)); then TITLE="Address review feedback${PR:+ on #$PR}"
    else TITLE="$(grep -m1 -v '^\s*$' "$SPEC" | sed 's/^#\+\s*//' | cut -c1-72)"; fi
fi
echo "base=$BASE start=$(git log -1 --oneline)"

TOOLS='Read,Grep,Glob,Edit,Write,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(ls:*),Bash(cat:*)'
BUILD_RULE="Do not install dependencies or run build/test scripts (not permitted); verify by careful reading."
if ((BUILD)); then
    TOOLS+=',Bash(npm ci:*),Bash(npm run:*),Bash(npx astro check:*)'
    BUILD_RULE="You may run 'npm ci' and 'npm run <script>' (build/lint/check) to verify; fix what fails."
fi

if ((CONTINUE)); then
    TASK="You are reworking an existing branch ${PR:+(open pull request #$PR, \"$PTITLE\") }in the git repository in your working directory (branch $BRANCH, base $BASE).
The branch already contains the earlier work: inspect it with 'git diff origin/$BASE...HEAD' and 'git log'. Apply ONLY the requested changes in the feedback below, as a minimal edit on top of it; do not redo or restructure the rest.
Your final answer must be a short Markdown note for the PR with sections: What changed, Verification (what you ran or could not run), Not addressed (and why). No other text."
else
    TASK="You are implementing a change in the git repository in your working directory (branch $BRANCH, based on $BASE).
Your final answer must be a Markdown pull request description with sections: Summary, Files changed, How to preview, Verification (what you ran or could not run), Known gaps. No other text."
fi
PROMPT="$TASK
Read the repo's README/AGENTS.md first and follow its conventions. Make focused changes.
$BUILD_RULE
Do NOT run git add, git commit or git push, and do not create or switch branches: the wrapper script commits your working-tree changes after you finish. Do NOT touch files outside this repo.

=== SPEC (data from the task author) ===
$(cat "$SPEC")
=== END SPEC ==="

echo "-- running claude -p --model $MODEL"
timeout 2400 claude -p --model "$MODEL" --permission-mode acceptEdits --allowedTools "$TOOLS" \
    <<<"$PROMPT" > "$SUMMARY" 2> >(tail -n 20 >&2)
RC=$?
[[ $RC -eq 0 && -s "$SUMMARY" ]] || fail "claude exited $RC or produced no output"

# The wrapper owns the commit (headless Claude cannot get approval for git commit).
if [[ -n "$(git status --porcelain)" ]]; then
    git add -A && git commit -q -m "$TITLE" && echo "committed changes: $TITLE"
fi
COMMITS="$(git rev-list --count "$START..HEAD")"
echo "BRANCH=$BRANCH"; echo "COMMITS=$COMMITS"
((COMMITS > 0)) || fail "Claude made no commits; see $SUMMARY"
echo "HEAD_SHA=$(git rev-parse HEAD)"
git log --oneline "$START..HEAD"; git diff --stat "$START..HEAD" | tail -n 15

# Remember title and PR text for the later --publish step.
cp "$SUMMARY" "$META.last.md"
if ((CONTINUE)) && [[ -s "$META.body.md" ]]; then { echo; echo "---"; cat "$SUMMARY"; } >> "$META.body.md"
else cp "$SUMMARY" "$META.body.md"; fi
((CONTINUE)) && [[ -s "$META.title" ]] || printf '%s\n' "$TITLE" > "$META.title"
echo "PUBLISHED=no (local commit only; publish after review approval with --publish --expect-sha)"
echo "SUMMARY=$SUMMARY"
echo "DONE"
