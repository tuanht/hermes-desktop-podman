# Dev sandbox for the Hermes `coder-remote` profile: sshd + Claude Code + git + common toolchains.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server ca-certificates curl wget gnupg sudo less vim nano tmux \
        git git-lfs openssh-client ripgrep fd-find jq unzip zip xz-utils tree procps \
        build-essential pkg-config cmake make \
        python3 python3-pip python3-venv pipx \
        golang-go \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && npm install -g @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# ubuntu:24.04 ships a default `ubuntu` user (uid 1000); replace it with `dev`.
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -s /bin/bash -u 1000 dev \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && mkdir -p /run/sshd /etc/ssh/authorized_keys /home/dev/work \
    && chown -R dev:dev /home/dev

# Key-only auth; keys come from the bind-mounted /etc/ssh/authorized_keys/dev.
COPY sshd_config /etc/ssh/sshd_config.d/10-hermes.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY blog-review /usr/local/bin/blog-review
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/blog-review

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
