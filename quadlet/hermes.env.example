# Copied to ~/.config/hermes/hermes.env by install.sh (chmod 600).
# Dashboard auth is mandatory on non-loopback binds (the container binds 0.0.0.0).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
# Keeps dashboard sessions valid across restarts.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me-too
# Optional: enable the OpenAI-compatible API on 8642.
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=at-least-8-characters
# Model/provider API keys can also go here, or be set via the setup wizard.
