# hermes-sandbox.container
# Ubuntu dev sandbox (sshd + Claude Code + git + toolchains) used as the SSH terminal backend
# of the Hermes `coder-remote` profile. Image is built locally by install.sh from sandbox/.
# Generated unit: hermes-sandbox.service. Reachable only on the `hermes` network (no published port).
#
# Claude Code login (once):  podman exec -it -u dev hermes-sandbox claude

[Unit]
Description=Hermes dev sandbox (SSH backend for coder-remote)
After=network-online.target

[Container]
ContainerName=hermes-sandbox
Image=localhost/hermes-sandbox:latest
Network=hermes.network
HostName=hermes-sandbox

Volume=hermes-sandbox.volume:/home/dev:Z
# Persist sshd host keys so the client's known_hosts stays valid across rebuilds.
Volume=hermes-sandbox-hostkeys:/etc/ssh/hostkeys:Z
# Public key generated by install.sh; root-owned inside the container, as sshd StrictModes requires.
Volume=%h/.config/hermes/coder-remote/authorized_keys:/etc/ssh/authorized_keys/dev:ro,Z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
